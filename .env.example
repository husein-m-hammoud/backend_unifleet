APP_NAME=UNIFLEET
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Base URL of the React SPA. EVERY LINK WE EMAIL IS BUILT FROM THIS: the
# "Sign in" button on a new-account email, and the password-reset link.
#
# Leaving the localhost value in production emails users a link to their own
# machine. It fails in the worst possible way - the email sends, looks correct,
# and the person simply cannot sign in. `php artisan unifleet:doctor` FAILS on a
# localhost value when APP_ENV=production, specifically to catch this.
#
# Production: FRONTEND_URL=https://fleet.unimaccompany.com   (http:// until TLS)
FRONTEND_URL=http://localhost:8089

# Set ONLY when TLS terminates in FRONT of this server (Alibaba SLB/ALB, CDN or
# WAF). Leave empty when nginx on this box holds the certificate - trusting a
# proxy that is not there lets any client forge X-Forwarded-* and spoof its own
# scheme and source IP, which would make the login rate limiter bypassable.
# Comma-separated IPs/CIDRs, or '*' (only safe if the security group restricts
# 80/443 to the proxy). See app/Providers/AppServiceProvider.php.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- First owner account (read by DatabaseSeeder) -----------------------------
# Credentials for the single account created by `php artisan db:seed`, used to
# log in and create every other user.
#
# Leave ADMIN_PASSWORD EMPTY in production: the seeder then generates a strong
# password and prints it once. Set it only for a scripted/local setup.
# The seeder never updates an existing account, so re-seeding cannot reset a
# password you have already changed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Needed for password-reset emails to that account. Nullable, but set it in prod.
ADMIN_EMAIL=

# --- Session / token lifetime -------------------------------------------------
# Minutes an API token stays valid (config/sanctum.php). 720 = 12h, which covers
# a shift without logging an operator out mid-day. Was previously unlimited.
SANCTUM_EXPIRATION_MINUTES=720

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=unifleet
DB_USERNAME=postgres
DB_PASSWORD=

# --- Safee Tracking providers ---
# Every provider is a Safee deployment; only host/realm/credentials differ.
# Each key added here is picked up automatically by `safee:poll`, `safee:health`
# and the diagnostics page.
# Must name a provider that is actually enabled in config/services.php.
# Alrakeen is paused (commented out there), so this must NOT be 'alrakeen' -
# a fresh .env copied from this file would otherwise point the poller at a
# provider that does not exist.
SAFEE_DEFAULT_PROVIDER=dsco

# Per-vehicle telemetry endpoints. Both OFF: the provider answers get-fuel-data
# and get-weight-data with result:null for every vehicle (Teltonika units with
# no fuel sensor / CAN adapter fitted), so leaving them on spent roughly 125,000
# HTTP requests a day fetching nothing. Flip to true per endpoint once the
# provider confirms sensors exist - nothing else needs changing.
SAFEE_POLL_FUEL=false
SAFEE_POLL_WEIGHT=false

SAFEE_ALRAKEEN_SERVER_URI=https://tk.alrakeen.sa
SAFEE_ALRAKEEN_REALM=alrakeen
SAFEE_ALRAKEEN_CLIENT_ID=api
SAFEE_ALRAKEEN_CLIENT_SECRET=
SAFEE_ALRAKEEN_USERNAME=
SAFEE_ALRAKEEN_PASSWORD=

# DSCO (Dimensions Systems) — second provider, re-onboarded 2026-10-24.
SAFEE_DSCO_SERVER_URI=https://fms.dimensions-systems.com
SAFEE_DSCO_REALM=dsco
SAFEE_DSCO_CLIENT_ID=api
SAFEE_DSCO_CLIENT_SECRET=
SAFEE_DSCO_USERNAME=
SAFEE_DSCO_PASSWORD=

# Poller interval in minutes (scheduler fires every 1 min; command enforces this)
SAFEE_POLL_INTERVAL_MINUTES=2

# How far back to look when no previous sync timestamp exists (hours)
SAFEE_LOOKBACK_HOURS=24

# Sanctum — comma-separated frontend origins allowed to use the API
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:3000,127.0.0.1:8080

# Google Maps API key (used by the React frontend)
VITE_GOOGLE_MAPS_API_KEY=

TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Ops alerting (for US, not the client) -----------------------------------
# Where `safee:health` sends "telemetry has gone stale" notices.
#
# Email is the only channel for now and it is IGNORED while MAIL_MAILER=log, so
# until a real SMTP mailer is configured a dead pipeline is detected and written
# to the log but NOT delivered to anyone. `php artisan unifleet:doctor` reports
# this as a failing `ops_alerts` check.
OPS_ALERT_EMAIL=

# Optional shared secret. When set, GET /api/health returns the FULL report to a
# caller passing ?token= or the X-Health-Token header; without it the endpoint
# stays terse (status + failing check names only). Uptime monitors need neither.
OPS_HEALTH_TOKEN=

CLAUDE_API_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes every email to storage/logs/laravel.log and SENDS NOTHING.
# Account-setup and password-reset emails are therefore silently undelivered -
# and UserController::tryNotify() swallows transport errors, so creating a user
# still reports success. DO NOT create real user accounts in production until
# this is a real mailer.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Must be an address the sending provider is authorised to send AS. With
# Microsoft 365 that means a real mailbox in the tenant. An unrecognised sender
# is the most common reason mail is accepted and then silently spam-filtered.
MAIL_FROM_ADDRESS="no-reply@unimaccompany.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Microsoft 365 — the recommended production mailer ───────────────────────
#
# Checked 2026-11-05: unimaccompany.com is hosted on Microsoft 365, and its mail
# authentication is already complete and strict:
#
#   MX     unimaccompany-com.mail.protection.outlook.com
#   SPF    v=spf1 include:spf.protection.outlook.com -all     <- HARD fail
#   DMARC  v=DMARC1; p=quarantine; pct=100                    <- enforced
#   DKIM   selector1/selector2 -> dkim.mail.microsoft          <- already signing
#
# That `-all` is why this matters. Mail sent as @unimaccompany.com from anywhere
# other than Microsoft fails SPF, and UNIMAC's own DMARC policy then quarantines
# it. A third-party sender (DirectMail, SES) would therefore need IT to widen an
# SPF record that currently hard-fails everything else - weakening their
# anti-spoofing posture - and until then credential emails land in spam.
#
# Sending through their existing M365 needs no new vendor, no cost, and no DNS
# work. Two ways, both requiring one action from UNIMAC IT:
#
# Option A - SMTP AUTH with a mailbox (needs a licensed mailbox; IT must enable
# SMTP AUTH for it, as Microsoft disables it by default):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.office365.com
#   MAIL_PORT=587
#   MAIL_SCHEME=tls
#   MAIL_USERNAME=no-reply@unimaccompany.com
#   MAIL_PASSWORD=<app password for that mailbox>
#
# Option B - Exchange Online relay connector (no mailbox, no password; IT
# authorises this server's IP 8.213.39.81 in a connector). Simplest to operate
# once set up, and nothing secret sits in this file:
#   MAIL_MAILER=smtp
#   MAIL_HOST=unimaccompany-com.mail.protection.outlook.com
#   MAIL_PORT=25
#   MAIL_SCHEME=null
#   MAIL_USERNAME=null
#   MAIL_PASSWORD=null
#
# Verify either with:  php artisan unifleet:mail-test you@example.com
# Outbound 587 (option A) or 25 (option B) must be allowed in the security group.
#
# ─── Alibaba Cloud DirectMail — fallback only ────────────────────────────────
# Kept for reference. NOT recommended while SPF is `-all`: see above. Also note
# the default host below is Singapore, so mail would leave the Kingdom.
# To enable: set MAIL_MAILER=directmail
# + a from-address on your own domain, and fill these. Host is region-specific
# (international/Gulf = smtpdm-ap-southeast-1.aliyun.com; confirm the Riyadh/SCCC endpoint).
# DIRECTMAIL_USERNAME = a verified DirectMail sender (e.g. no-reply@fleet.unimac.sa);
# DIRECTMAIL_PASSWORD = that sender's SMTP password. Requires SPF/DKIM/DMARC on the domain.
DIRECTMAIL_HOST=smtpdm-ap-southeast-1.aliyun.com
DIRECTMAIL_PORT=465
DIRECTMAIL_SCHEME=smtps
DIRECTMAIL_USERNAME=null
DIRECTMAIL_PASSWORD=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
