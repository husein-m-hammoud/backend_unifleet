APP_NAME=UNIFLEET
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Base URL of the React SPA — used to build password-reset links.
FRONTEND_URL=http://localhost:8089

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=unifleet
DB_USERNAME=postgres
DB_PASSWORD=

DSCO_BASE_URL=
DSCO_AUTH_URL=
DSCO_CLIENT_ID=
DSCO_CLIENT_SECRET=
DSCO_USERNAME=
DSCO_PASSWORD=

# Poller interval in minutes (scheduler fires every 1 min; command enforces this)
DSCO_POLL_INTERVAL_MINUTES=2

# How far back to look when no previous sync timestamp exists (hours)
DSCO_LOOKBACK_HOURS=24

# Sanctum — comma-separated frontend origins allowed to use the API
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:3000,127.0.0.1:8080

# Google Maps API key (used by the React frontend)
VITE_GOOGLE_MAPS_API_KEY=

TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

CLAUDE_API_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Alibaba Cloud DirectMail (planned prod mailer). To enable: set MAIL_MAILER=directmail
# + a from-address on your own domain, and fill these. Host is region-specific
# (international/Gulf = smtpdm-ap-southeast-1.aliyun.com; confirm the Riyadh/SCCC endpoint).
# DIRECTMAIL_USERNAME = a verified DirectMail sender (e.g. no-reply@fleet.unimac.sa);
# DIRECTMAIL_PASSWORD = that sender's SMTP password. Requires SPF/DKIM/DMARC on the domain.
DIRECTMAIL_HOST=smtpdm-ap-southeast-1.aliyun.com
DIRECTMAIL_PORT=465
DIRECTMAIL_SCHEME=smtps
DIRECTMAIL_USERNAME=null
DIRECTMAIL_PASSWORD=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
